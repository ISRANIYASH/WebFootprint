*.db
*.sqlite
*.sqlite3
!sample_data/*.db
!sample_data/*.sqlite

# Uploaded evidence and generated reports (runtime evidence files)
uploads/*
!uploads/.gitkeep
generated_reports/*
!generated_reports/.gitkeep

# Flask instance folder
instance/

